digraph viz {
  label="Signal Graph";
  labelloc=t;
  rankdir=TB;
  splines=spline;
  nodesep=0.4;
  ranksep=0.6;
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10];
  bgcolor=white;
  newrank=true;  // [V6.8] enforce cluster rank ordering

  "synchronizer.clk_i" [label="clk_i [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#88888822"; color="#888888"];
  "synchronizer.rst_ni" [label="rst_ni [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#cc444422"; color="#cc4444"];
  "synchronizer.async_i" [label="async_i [PORT_IN]"; shape=invhouse; fillcolor="#ff883322"; color="#ff8833"];
  "synchronizer.sync0_o" [label="sync0_o [REG]"; shape=box; fillcolor="#ff883322"; color="#ff8833"];
  "synchronizer.sync1" [label="sync1 [REG]"; shape=box; fillcolor="#ff883322"; color="#ff8833"];
  "uart_top.clk_i" [label="clk_i [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#88888822"; color="#888888"];
  "uart_top.rst_ni" [label="rst_ni [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#cc444422"; color="#cc4444"];
  "uart_top.rx_i" [label="rx_i [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "uart_top.tx_data_i" [label="tx_data_i [PORT_IN] [7:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "uart_top.tx_o" [label="tx_o [PORT_OUT] [1:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "uart_top.rx_data_o" [label="rx_data_o [PORT_OUT] [7:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "uart_top.rx_ready_o" [label="rx_ready_o [PORT_OUT] [1:0]"; shape=invhouse; fillcolor="#ff883322"; color="#ff8833"];
  "sync_fifo.clk_i" [label="clk_i [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#88888822"; color="#888888"];
  "sync_fifo.rst_ni" [label="rst_ni [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#cc444422"; color="#cc4444"];
  "sync_fifo.push_i" [label="push_i [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.pop_i" [label="pop_i [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.push_data_i" [label="push_data_i [PORT_IN] [7:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.pop_data_o" [label="pop_data_o [REG] [7:0]"; shape=box; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.full_o" [label="full_o [PORT_OUT] [1:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.empty_o" [label="empty_o [PORT_OUT] [1:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.mem" [label="mem"; shape=ellipse; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.count_q" [label="count_q [REG]"; shape=box; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.wr_ptr_q" [label="wr_ptr_q [REG]"; shape=box; fillcolor="#ff883322"; color="#ff8833"];
  "sync_fifo.rd_ptr_q" [label="rd_ptr_q [REG] [1:0]"; shape=box; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.mem[wr_ptr_q[<expr> - 1:0]]" [label="mem[wr_ptr_q[Expression(ExpressionKind.Call) - 1:0]] [REG] [1:0]"; shape=box; fillcolor="#4477cc22"; color="#4477cc"];
  "uart_top.rx_fifo" [label="rx_fifo [INSTANTIATED_MODULE] [1:0]"; shape=box3d; fillcolor="#f0f0f0"; color="#888888"];
  "uart_top.rx_fifo.clk_i" [label="clk_i [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#88888822"; color="#888888"];
  "uart_top.rx_fifo.rst_ni" [label="rst_ni [PORT_IN] [1:0]"; shape=invhouse; fillcolor="#cc444422"; color="#cc4444"];
  "uart_top.rx_fifo.pop_data_o" [label="pop_data_o [PORT_OUT] [7:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "uart_top.rx_fifo.empty_o" [label="empty_o [PORT_OUT] [1:0]"; shape=invhouse; fillcolor="#4477cc22"; color="#4477cc"];
  "1'b0" [label="1'b0 [CONST]"; shape=hexagon; fillcolor="#4477cc22"; color="#4477cc"];
  "5'b0" [label="5'b0 [CONST]"; shape=hexagon; fillcolor="#4477cc22"; color="#4477cc"];
  "sync_fifo.mem]" [label="mem] [REG] [1:0]"; shape=box; fillcolor="#4477cc22"; color="#4477cc"];

  "synchronizer.async_i" -> "synchronizer.sync1" [label="!(!rst_ni)\n`timescale 1ns/1ps
module sync"; fontsize=9];
  "synchronizer.sync1" -> "synchronizer.sync0_o" [label="!(!rst_ni)\n`timescale 1ns/1ps
module sync"; fontsize=9];
  "uart_top.clk_i" -> "uart_top.rx_fifo.clk_i" [style=solid];
  "uart_top.rst_ni" -> "uart_top.rx_fifo.rst_ni" [style=solid];
  "sync_fifo.push_data_i" -> "sync_fifo.mem[wr_ptr_q[<expr> - 1:0]]" [label="!(!rst_ni) && push_i && !full_o\n`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.mem" -> "sync_fifo.pop_data_o" [label="!(!rst_ni) && pop_i && !empty_o\n`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.count_q" -> "sync_fifo.empty_o" [label="`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.count_q" -> "sync_fifo.full_o" [label="`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.count_q" -> "sync_fifo.count_q" [label="!(!rst_ni) && {push_i && !full_o, pop_i \n`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.count_q" -> "sync_fifo.count_q" [label="!(!rst_ni) && {push_i && !full_o, pop_i \n`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.wr_ptr_q" -> "sync_fifo.wr_ptr_q" [label="!(!rst_ni) && push_i && !full_o\n`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.rd_ptr_q" -> "sync_fifo.rd_ptr_q" [label="!(!rst_ni) && pop_i && !empty_o\n`timescale 1ns/1ps
module sync"; fontsize=9];
  "sync_fifo.mem[wr_ptr_q[<expr> - 1:0]]" -> "sync_fifo.mem]" [arrowhead="open"];
  "uart_top.rx_fifo.clk_i" -> "uart_top.rx_fifo.clk_i" [style=solid];
  "uart_top.rx_fifo.clk_i" -> "uart_top.rx_fifo" [arrowhead="open"];
  "uart_top.rx_fifo.rst_ni" -> "uart_top.rx_fifo.rst_ni" [style=solid];
  "uart_top.rx_fifo.rst_ni" -> "uart_top.rx_fifo" [arrowhead="open"];
  "uart_top.rx_fifo.pop_data_o" -> "uart_top.rx_fifo.pop_data_o";
  "uart_top.rx_fifo.pop_data_o" -> "uart_top.rx_data_o" [style=solid];
  "uart_top.rx_fifo.pop_data_o" -> "uart_top.rx_fifo" [arrowhead="open"];
  "uart_top.rx_fifo.empty_o" -> "uart_top.rx_fifo.empty_o";
  "uart_top.rx_fifo.empty_o" -> "uart_top.rx_ready_o" [style=solid];
  "uart_top.rx_fifo.empty_o" -> "uart_top.rx_fifo" [arrowhead="open"];
  "1'b0" -> "synchronizer.sync1" [label="!rst_ni"; fontsize=9];
  "1'b0" -> "synchronizer.sync0_o" [label="!rst_ni"; fontsize=9];
  "5'b0" -> "sync_fifo.count_q" [label="!rst_ni"; fontsize=9];
  "5'b0" -> "sync_fifo.wr_ptr_q" [label="!rst_ni"; fontsize=9];
  "5'b0" -> "sync_fifo.rd_ptr_q" [label="!rst_ni"; fontsize=9];
}