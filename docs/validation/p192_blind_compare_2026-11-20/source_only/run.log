    lsu_req_i = 1; lsu_vaddr_i = Np1;
    repeat (14) @(posedge clk); #1;
    lsu_req_i = 1; lsu_vaddr_i = Np1;
    @(posedge clk); #1;
    $display("[legit Np1] cyc=%0d in_vaddr=%h q_vaddr=%h dtlb_hit_q=%b can=%b -> exc.valid=%b exc.cause=%0d tval=%h",
             cyc, lsu_vaddr_i, CANARY, u_mmu.dtlb_hit_q,
