             lsu_exception_o.cause, lsu_exception_o.tval);
    @(posedge clk); #1;
    lsu_req_i = 0;
    repeat (3) @(posedge clk);
'''
for name, canary in [('tb_mmu.sv','canonical_addr_check'), ('tb_mmu_fixed.sv','canonical_addr_check_q')]:
