{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fundou1081/sv_query/tools/llm_schema.json",
  "title": "sv_query LLM Schema",
  "description": "[Phase 2 B1 2026-06-28] JSON Schema for sv_query CLI output, for LLM consumption. All commands return JSON via --json flag.",
  "version": "1.2.0",
  "definitions": {
    "SignalId": {
      "type": "string",
      "description": "Hierarchical signal identifier or Verilog literal. e.g. \"top.cpu.q\" or \"5'b0\". V6.9 driver extraction now returns literals for constant drivers.",
      "pattern": "^(?:[a-zA-Z0-9_][a-zA-Z0-9_.]*(\\[.+\\])?|[0-9]+'[bdho]?[0-9a-fA-FxXzZ_]+)$"
    },
    "EdgeKind": {
      "type": "string",
      "enum": [
        "BIT_SELECT",
        "BRANCH_CONDITION",
        "BRANCH_FALSE",
        "BRANCH_RESULT",
        "BRANCH_TRUE",
        "CASE_ITEM",
        "CASE_RESULT",
        "CASE_SELECT",
        "CLOCK",
        "CONNECTION",
        "CONSTRAINS",
        "CONTAINS_MEMBER",
        "DRIVER",
        "HAS_AFTER",
        "HAS_ALTERNATE",
        "HAS_BEFORE",
        "HAS_CONDITION",
        "HAS_CONSEQUENT",
        "HAS_LHS",
        "HAS_LOOP_VAR",
        "HAS_MEMBER",
        "HAS_RHS",
        "IS_INSTANCE_OF",
        "MEMBER_SELECT",
        "RESET",
        "SUPER_CALL"
      ],
      "description": "Edge kind in graph (DRIVER, CLOCK, RESET, CONNECTION, BIT_SELECT, etc.)"
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "description": "Risk classification level"
    },
    "CommonResult": {
      "type": "object",
      "required": [
        "ok",
        "command"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "true if success, false if error"
        },
        "command": {
          "type": "string",
          "description": "Command name (e.g., 'trace_fanout')"
        },
        "params": {
          "type": "object",
          "description": "Echo of input parameters"
        },
        "result": {
          "description": "Command-specific result (varies by command)"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of error messages"
        }
      }
    },
    "ErrorResult": {
      "type": "object",
      "required": [
        "ok",
        "error_code"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "type": "string"
        },
        "error": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "error_code": {
          "type": "string",
          "enum": [
            "E_ELABORATION_FAILED",
            "E_FILELIST_INCOMPLETE",
            "E_FILELIST_INVALID",
            "E_FILELIST_NOT_FOUND",
            "E_FILE_NOT_FOUND",
            "E_INTERNAL",
            "E_INVALID_INPUT",
            "E_NO_DATA",
            "E_PARSE_ERROR",
            "E_PARTIAL_RESULT",
            "E_SIGNAL_AMBIGUOUS",
            "E_SIGNAL_NOT_FOUND",
            "E_TARGET_NOT_FOUND",
            "E_USAGE"
          ],
          "description": "[B2 2026-06-28] Stable error code for LLM error classification"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "CLASS",
        "CLASS_INSTANCE",
        "CLASS_INSTANCE_PROPERTY",
        "CLASS_PROPERTY",
        "CONST",
        "CONSTRAINT_BLOCK",
        "CONSTRAINT_ELSE",
        "CONSTRAINT_EXPR",
        "CONSTRAINT_FOREACH",
        "CONSTRAINT_IF",
        "CONSTRAINT_IMPLIES",
        "CONSTRAINT_RANGE",
        "CONSTRAINT_SOLVE",
        "CONSTRAINT_UNIQUE",
        "EXPRESSION",
        "FUNCTION_CALL",
        "GENERATE_BLOCK",
        "INSTANTIATED_MODULE",
        "OP_CASE",
        "OP_TERNARY",
        "PARAM",
        "PORT_IN",
        "PORT_INOUT",
        "PORT_OUT",
        "REG",
        "SIGNAL",
        "WIRE"
      ],
      "description": "Node kind in graph (signal/port/reg/instantiated module/etc.)"
    }
  },
  "commands": {
    "stats": {
      "description": "Show graph statistics (nodes, edges, modules, fanout ranking)",
      "result_schema": {
        "type": "object",
        "properties": {
          "total_nodes": {
            "type": "integer"
          },
          "total_edges": {
            "type": "integer"
          },
          "nodes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Count per node kind"
          },
          "edges": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Count per edge kind"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Module names in design"
          },
          "elaboration_errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "pyslang elaboration errors (if any)"
          }
        }
      }
    },
    "trace_fanin": {
      "description": "Trace signal drivers (upstream) — batch + filters supported",
      "params_schema": {
        "type": "object",
        "required": [
          "signals"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/SignalId"
            },
            "description": "[B1 2026-07-03] List of signals (always 1+, batch mode produces >1)"
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Max trace depth (null=unlimited)"
          },
          "max_results": {
            "type": [
              "integer",
              "null"
            ],
            "description": "[C1] Cap on result count per signal"
          },
          "batch_file": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B1] Path to batch file"
          },
          "batch": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B1] Inline batch (comma-separated)"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B2] --type filter (NodeKind, comma-separated)"
          },
          "module": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B2] --module filter (fnmatch glob)"
          },
          "width_min": {
            "type": [
              "integer",
              "null"
            ],
            "description": "[B2] --width-min filter"
          },
          "width_max": {
            "type": [
              "integer",
              "null"
            ],
            "description": "[B2] --width-max filter"
          },
          "exclude": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B2] --exclude filter (fnmatch glob)"
          }
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "signals",
          "total_signals",
          "total_count",
          "total_pre_filter",
          "truncated"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "signal",
                "index",
                "drivers",
                "count",
                "pre_filter_count",
                "truncated"
              ],
              "properties": {
                "signal": {
                  "$ref": "#/definitions/SignalId"
                },
                "index": {
                  "type": "integer"
                },
                "drivers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "kind",
                      "module",
                      "width_msb",
                      "width_lsb",
                      "width",
                      "distance"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/definitions/SignalId"
                      },
                      "kind": {
                        "$ref": "#/definitions/NodeKind"
                      },
                      "module": {
                        "type": "string",
                        "description": "[B2] Module name owning this signal"
                      },
                      "width_msb": {
                        "type": "integer",
                        "description": "[B2] Width tuple msb"
                      },
                      "width_lsb": {
                        "type": "integer",
                        "description": "[B2] Width tuple lsb"
                      },
                      "width": {
                        "type": "integer",
                        "description": "[B2] Bit width (msb - lsb + 1)"
                      },
                      "distance": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "count": {
                  "type": "integer"
                },
                "pre_filter_count": {
                  "type": "integer",
                  "description": "[B2] Count before filter"
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            }
          },
          "total_signals": {
            "type": "integer",
            "description": "[B1] Number of input signals"
          },
          "total_count": {
            "type": "integer",
            "description": "[B1] Sum of count after filter"
          },
          "total_pre_filter": {
            "type": "integer",
            "description": "[B2] Sum of pre_filter_count before filter"
          },
          "truncated": {
            "type": "boolean",
            "description": "True if any signal hit max_results cap"
          }
        }
      }
    },
    "trace_fanout": {
      "description": "Trace signal loads (downstream) — batch + filters supported",
      "params_schema": {
        "type": "object",
        "required": [
          "signals"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/SignalId"
            },
            "description": "[B1 2026-07-03] List of signals (always 1+, batch mode produces >1)"
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Max trace depth (null=unlimited)"
          },
          "max_results": {
            "type": [
              "integer",
              "null"
            ],
            "description": "[C1] Cap on result count per signal"
          },
          "batch_file": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B1] Path to batch file"
          },
          "batch": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B1] Inline batch (comma-separated)"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B2] --type filter (NodeKind, comma-separated)"
          },
          "module": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B2] --module filter (fnmatch glob)"
          },
          "width_min": {
            "type": [
              "integer",
              "null"
            ],
            "description": "[B2] --width-min filter"
          },
          "width_max": {
            "type": [
              "integer",
              "null"
            ],
            "description": "[B2] --width-max filter"
          },
          "exclude": {
            "type": [
              "string",
              "null"
            ],
            "description": "[B2] --exclude filter (fnmatch glob)"
          }
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "signals",
          "total_signals",
          "total_count",
          "total_pre_filter",
          "truncated"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "signal",
                "index",
                "loads",
                "count",
                "pre_filter_count",
                "truncated"
              ],
              "properties": {
                "signal": {
                  "$ref": "#/definitions/SignalId"
                },
                "index": {
                  "type": "integer"
                },
                "loads": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "kind",
                      "module",
                      "width_msb",
                      "width_lsb",
                      "width",
                      "distance"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/definitions/SignalId"
                      },
                      "kind": {
                        "$ref": "#/definitions/NodeKind"
                      },
                      "module": {
                        "type": "string",
                        "description": "[B2] Module name owning this signal"
                      },
                      "width_msb": {
                        "type": "integer",
                        "description": "[B2] Width tuple msb"
                      },
                      "width_lsb": {
                        "type": "integer",
                        "description": "[B2] Width tuple lsb"
                      },
                      "width": {
                        "type": "integer",
                        "description": "[B2] Bit width (msb - lsb + 1)"
                      },
                      "distance": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "count": {
                  "type": "integer"
                },
                "pre_filter_count": {
                  "type": "integer",
                  "description": "[B2] Count before filter"
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            }
          },
          "total_signals": {
            "type": "integer",
            "description": "[B1] Number of input signals"
          },
          "total_count": {
            "type": "integer",
            "description": "[B1] Sum of count after filter"
          },
          "total_pre_filter": {
            "type": "integer",
            "description": "[B2] Sum of pre_filter_count before filter"
          },
          "truncated": {
            "type": "boolean",
            "description": "True if any signal hit max_results cap"
          }
        }
      }
    },
    "trace_impact": {
      "description": "Analyze impact of changing a signal (downstream blast radius + risk + coverage)",
      "params_schema": {
        "type": "object",
        "required": [
          "signals"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/SignalId"
            },
            "description": "[B1 2026-07-03] List of signals (always 1+)"
          },
          "min_risk": {
            "type": "number",
            "description": "Minimum risk score for HIGH classification"
          },
          "batch_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "batch": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "signals",
          "total_signals",
          "total_paths",
          "total_high_risk_count"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "signal",
                "index",
                "total_paths",
                "high_risk_count",
                "modules",
                "paths"
              ],
              "properties": {
                "signal": {
                  "$ref": "#/definitions/SignalId"
                },
                "index": {
                  "type": "integer"
                },
                "total_paths": {
                  "type": "integer"
                },
                "high_risk_count": {
                  "type": "integer"
                },
                "modules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "path_type",
                      "risk",
                      "risk_score",
                      "fanout",
                      "coverage"
                    ],
                    "properties": {
                      "path": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/SignalId"
                        }
                      },
                      "path_type": {
                        "type": "string",
                        "enum": [
                          "combinational",
                          "conditional",
                          "clocked"
                        ]
                      },
                      "risk": {
                        "$ref": "#/definitions/RiskLevel"
                      },
                      "risk_score": {
                        "type": "number"
                      },
                      "fanout": {
                        "type": "integer"
                      },
                      "coverage": {
                        "type": "object",
                        "properties": {
                          "sva": {
                            "type": "string",
                            "enum": [
                              "covered",
                              "none"
                            ]
                          },
                          "covergroup": {
                            "type": "string",
                            "enum": [
                              "covered",
                              "none"
                            ]
                          }
                        }
                      },
                      "condition": {
                        "type": "string"
                      },
                      "clock_domain": {
                        "type": "string"
                      },
                      "suggestion": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "total_signals": {
            "type": "integer"
          },
          "total_paths": {
            "type": "integer"
          },
          "total_high_risk_count": {
            "type": "integer"
          }
        }
      }
    },
    "trace_evidence": {
      "description": "Show source-code evidence (enclosing always/if/class/constraint) for signal(s)",
      "params_schema": {
        "type": "object",
        "required": [
          "signals"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/SignalId"
            },
            "description": "[B1 2026-07-03] List of signals (always 1+)"
          },
          "chain": {
            "type": "boolean",
            "description": "If true, evidence is array (chain), else object (single)"
          },
          "batch_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "batch": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "signals",
          "total_signals"
        ],
        "properties": {
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "signal",
                "index",
                "evidence"
              ],
              "properties": {
                "signal": {
                  "$ref": "#/definitions/SignalId"
                },
                "index": {
                  "type": "integer"
                },
                "evidence": {
                  "description": "[B1] Single evidence object (chain=false) or array (chain=true)"
                }
              }
            }
          },
          "total_signals": {
            "type": "integer"
          }
        }
      }
    }
  },
  "usage": {
    "success_pattern": {
      "ok": true,
      "command": "trace_fanout",
      "params": {
        "signal": "top.clk",
        "file": "/path/to/file.sv",
        "depth": null,
        "max_results": 10,
        "signals": [
          "top.clk",
          "top.data"
        ]
      },
      "result": {
        "signals": [
          {
            "signal": "top.clk",
            "index": 0,
            "loads": [
              {
                "id": "top.q",
                "kind": "REG",
                "module": "top",
                "width_msb": 0,
                "width_lsb": 0,
                "width": 1,
                "distance": 1
              }
            ],
            "count": 1,
            "pre_filter_count": 1,
            "truncated": false
          },
          {
            "signal": "top.data",
            "index": 1,
            "loads": [],
            "count": 0,
            "pre_filter_count": 0,
            "truncated": false
          }
        ],
        "total_signals": 2,
        "total_count": 1,
        "total_pre_filter": 1,
        "truncated": false
      },
      "errors": []
    },
    "error_pattern": {
      "ok": false,
      "command": "trace_fanin",
      "error": "[Errno 2] No such file or directory: '/tmp/missing.sv'",
      "error_code": "E_FILE_NOT_FOUND",
      "errors": [
        "[Errno 2] No such file or directory: '/tmp/missing.sv'"
      ]
    },
    "llm_tips": [
      "Always pass --json (or -j) for parseable output (place it AFTER the subcommand, e.g. 'trace fanin X -f F --json')",
      "Use --quiet (or -q) to suppress stderr warnings (LLM-friendly)",
      "Use --max-results/-N on trace fanin/fanout to cap long chains; dataflow analyze uses --max-paths/-n (no --summary flag exists)",
      "Check error_code field when present for stable classification; not every command emits it (fallback: 'ok' + error message)"
    ]
  },
  "changelog": [
    {
      "version": "1.2.0",
      "date": "2026-11-11",
      "changes": [
        "REMOVED cdc_analyze/cdc_analyze_summary/risk_analyze/risk_analyze_summary: 对应 CLI 命令已退役 (iter_263, 6de54621)",
        "REMOVED reusable_schemas.SignalRisk/RiskSummary: 仅被已退役命令引用",
        "ADDED E_FILELIST_INCOMPLETE/E_FILELIST_INVALID/E_SIGNAL_AMBIGUOUS: 代码 ErrorCode 里有但 schema 漏了",
        "llm_tips: --summary flag 已不存在, 改为 --max-paths/-n (dataflow analyze)"
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-07-03",
      "changes": [
        "trace_fanin/trace_fanout: batch schema (result.signals[] replaces result.drives/loads)",
        "trace_fanin/trace_fanout: 5 new filter options (--type/--module/--width-min/max/--exclude)",
        "trace_fanin/trace_fanout: each driver/load has module + width_msb/width_lsb/width fields",
        "trace_fanin/trace_fanout: pre_filter_count + total_pre_filter for filter transparency",
        "trace_impact: NEW command schema (batch mode, paths + risk + coverage)",
        "trace_evidence: NEW command schema (batch mode, evidence per signal)"
      ]
    }
  ]
}