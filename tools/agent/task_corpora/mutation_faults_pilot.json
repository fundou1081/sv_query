    {
      "id": "multi_driver_literal",
      "source": "sim/tests/fixtures/dataflow_budget/diamond.sv",
      "top": "diamond_top",
      "query": "drivers",
      "signal": "diamond_top.p2_0",
      "mutation": {
        "old": "assign p2_0 = p1_0 | p1_1;",
