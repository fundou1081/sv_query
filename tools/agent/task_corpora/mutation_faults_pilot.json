{
  "description": "P165.3.2 mutation pilot: mutation diff is ground truth; Verilator is independent compile oracle.",
  "tasks": [
    {
      "id": "simple_driver_swap",
      "source": "sim/test_simple.sv",
      "top": "top",
      "query": "drivers",
      "signal": "top.data",
      "mutation": {
        "old": "assign data = din;",
        "new": "assign data = en;"
      },
      "expect": {
        "before": {
          "contains": [
            "top.din"
          ]
        },
        "after": {
          "contains": [
            "top.en"
          ],
          "not_contains": [
            "top.din"
          ]
        }
      }
    },
    {
      "id": "simple_driver_removed",
      "source": "sim/test_simple.sv",
      "top": "top",
      "query": "loads",
      "signal": "top.din",
      "mutation": {
        "old": "assign data = din;",
        "new": "assign data = 1'b0;"
      },
      "expect": {
        "before": {
          "contains": [
            "top.data"
          ]
        },
        "after": {
          "not_contains": [
            "top.data"
          ]
        }
      }
    },
    {
      "id": "sync_second_flop_swap",
      "source": "sim/tests/fixtures/minimal_3module/top.sv",
      "filelist": "sim/tests/fixtures/minimal_3module/filelist.f",
      "query": "drivers",
      "signal": "synchronizer.sync1",
      "mutation": {
        "old": "sync1 <= sync0;",
        "new": "sync1 <= async_i;"
      },
      "expect": {
        "before": {
          "contains": [
            "synchronizer.sync0"
          ]
        },
        "after": {
          "not_contains": [
            "synchronizer.sync0"
          ]
        }
      }
    },
    {
